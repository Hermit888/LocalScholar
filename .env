# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=localscholar
POSTGRES_USER=postgres   # your PostgreSQL username
POSTGRES_PASSWORD=       # your PostgreSQL password

# ─── Semantic Scholar (optional; with key: 10 req/s, without: 1 req/s) ───────
SEMANTIC_SCHOLAR_API_KEY=

# ─── Ollama (local LLM runtime) ──────────────────────────
OLLAMA_HOST=http://localhost:11434
# Query understanding model – non-thinking mode for speed.
# Qwen3 family supports think=false via Ollama API.
# Change to qwen3:1.7b after: ollama pull qwen3:1.7b
OLLAMA_MODEL=qwen3:1.7b

# ─── Qdrant ───────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ─── Local storage path for cached PDFs ──────────────────
PDF_STORAGE_DIR=./data/pdfs
