# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=localscholar
POSTGRES_USER=postgres           # your PostgreSQL username
POSTGRES_PASSWORD=              # your PostgreSQL password

# ─── Semantic Scholar (optional; with key: 10 req/s, without: 1 req/s) ───────
SEMANTIC_SCHOLAR_API_KEY=

# ─── Ollama (local LLM runtime) ──────────────────────────
OLLAMA_HOST=http://localhost:11434
# Query understanding model – non-thinking mode for speed (Discovery Layer).
# QA Layer uses the same model weights in thinking mode.
# Download: ollama pull qwen3.5:2b
# Switch back to qwen3.5:2b once download is complete.
OLLAMA_MODEL=qwen3.5:2b

# Reranker cross-encoder (Discovery Layer second-stage ranking)
# Download happens automatically on first use via HuggingFace Hub (~22 MB)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ─── Qdrant ───────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ─── Local storage path for cached PDFs ──────────────────
PDF_STORAGE_DIR=./data/pdfs
